# ---- Azure OpenAI (required) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4.1-mini

# ---- Demo database (optional) ----
# A PostgreSQL URL for the built-in Chinook demo ("Use demo database" button
# and load_data.py). Not needed if users connect their own database.
DATABASE_URL=

# Password that unlocks the ADMIN role on the DEMO database only.
# Custom databases use the "Admin password" typed in the connection form.
ADMIN_PASSWORD=

# ---- Hardening (optional) ----
# true = refuse connections to localhost / private networks (use this when
# the app is deployed on a server that users can reach).
BLOCK_PRIVATE_HOSTS=false

# Maximum SQLite upload size in MB (default 100).
MAX_SQLITE_UPLOAD_MB=100

# ---- Reliability / logging (optional) ----
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
PARALLEL_ANALYSIS=true
LOG_LEVEL=INFO
